# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Anthropic — used for structured extraction and summarization inside tools
ANTHROPIC_API_KEY=

# Serper — Google Search JSON API (https://serper.dev), used for competitor discovery + review search
# Sign up for a free account to get your key (~2500 free searches, then $0.001/search)
SERPER_API_KEY=

# Google (OAuth credentials go in credentials.json / token.json)
